# ============================================================
#  改密 Worker 配置
#  用法：把这个文件复制成 .env，然后按需修改
# ============================================================

# —— 必填 ——
# 账号管理器的地址（默认就好，除非你改了端口）
VAULT_BASE=http://127.0.0.1:8787

# API Key：打开账号管理器 →「设置」页 →「自动化接入密钥」→ 复制，粘贴到这里
# ★ 这行只是占位示例，必须换成你自己的 ★
#   每台机器的钥匙都不一样，直接从别人那里抄一个是用不了的。
VAULT_API_KEY=在这里粘贴你自己的接入密钥

# —— 可选：运行方式 ——
# worker 名字，会显示在「待改密」的卡片上（谁在处理）
WORKER_NAME=my-worker

# 没任务时多久轮询一次（秒）
POLL_SECONDS=5

# 处理完一个账号后等多久再处理下一个（秒）
# ★ 别设太小。Steam 对短时间大量改密很敏感，可能触发风控甚至临时锁定。
INTERVAL_SECONDS=45

# —— 可选：浏览器 ——
# 先用有界面跑通，确认流程没问题再考虑改 true
HEADLESS=false

# 用哪个浏览器：chrome / msedge / chromium
BROWSER_CHANNEL=chrome

# 勾选「记住我」吗？默认 false —— 不留长期会话在这台机器上更安全
KEEP_LOGGED_IN=false

# 每步操作之间放慢多少毫秒（方便你肉眼观察，跑通后可以改 0）
SLOW_MO_MS=120

# 出错时保持浏览器打开，方便你看现场（不会阻塞失败上报，后台倒计时关闭）
KEEP_BROWSER_OPEN_ON_ERROR=true
# 浏览器多留多少秒
KEEP_BROWSER_OPEN_SECS=60

# 「处理中」超过这么多分钟的任务，视为上次没收尾，启动时自动放回队列重试
# （修「worker 被杀掉后账号永远卡在待改密」的死状态）
STALE_TASK_MINUTES=20

# —— 可选：改密流程 ——
# 新密码固定为 10~12 位随机，必须以字母开头，只含数字与大小写字母。不需要配置。

# 在控制台打印每次生成的新密码（默认 true）
# 想避免密码留在终端回滚缓冲区里，就改成 false
SHOW_PASSWORD=true

# —— 输入节奏（★ 这几个值是修「输入的密码无效」的关键，不要轻易调小）——
# 原因：用 fill() 一次性塞值，React 来不及更新内部状态，
#       点提交时 Steam 收到的是空值 → 报「输入的密码无效」。
# 逐字符输入时每个字符之间的毫秒数（填 0 = 退回一次性填充，不推荐）
TYPE_DELAY_MS=45
# 每个密码框填完后等待多久，给表单校验留时间
FIELD_SETTLE_MS=400
# 点击「更改密码」之前等待多久，给 React 状态更新留时间
SUBMIT_SETTLE_MS=1200

# 提交后最多花多久自动检测「是否真的改成功了」（毫秒）
VERIFY_TIMEOUT_MS=60000

# 登录后如果脚本无法自动走到改密表单，等你手动操作的最长时间（分钟）
ASSIST_MINUTES=8

# —— 自动取验证码 ——
# 账号在管理器里关联了邮箱时，登录遇到 Steam Guard 验证码会自动去邮箱取
AUTO_CODE=true
# 取码时让服务端在邮箱里最多轮询多少秒（邮件通常几秒到几十秒才到）
CODE_WAIT_SEC=90
# 登录阶段最多等多久（毫秒）—— 留够你手动输验证码的时间
LOGIN_TIMEOUT_MS=180000
# 最多自动填几次验证码。Steam 有时输完第一次码后会再弹一屏要求
# "通过电子邮件发送账户验证码"，点了才会发第二次码 —— 所以至少给 2 次
MAX_CODE_ROUNDS=3
# 最多自动点几次"重新发送验证码"
MAX_RESENDS=2

# 提交新密码前暂停，让你先检查页面（首次跑建议 true，跑通后改 false）
PAUSE_BEFORE_SUBMIT=false

# Steam 改密向导地址（Steam 若改版，这里可以直接换成新地址，不用改代码）
# STEAM_WIZARD_URL=https://help.steampowered.com/zh-cn/wizard/HelpChangePassword

# —— 可选：输出 ——
# 截图与「新密码恢复文件」放哪
OUT_DIR=out
